// Data model — spec section 3 plus section 4's users / rosters / matches /
// game_results, adapted for Phase 1 scope. Key adaptations from the spec's
// schema, decided when this landed (see README "Draft flow & matchmaking"
// for the full reasoning):
//
// - No auth (Phase 1 spec: "anonymous sessions"): `users.session_token` is a
//   random UUID the *client* generates and persists in localStorage, sent as
//   an `X-Session-Token` header — not a login, not a signed cookie. A User
//   row is upserted lazily the first time a token is seen. This is a casual
//   friend-match MVP, not a security boundary.
// - Friend-link matchmaking only (Phase 1 skips the random queue), so
//   `matches` only ever needs a short `room_code`, not queue state.
//   `games_to_play` is kept per spec's schema but Phase 1 hardcodes it to 1
//   — best-of-N series (spec 5.6) is out of scope for now.
// - The spec's draft flow says picks aren't streamed live and doesn't
//   describe a shared/contested player pool — both users draft independently
//   from the same always-available pool (they CAN both draft the same
//   player). `rosters.slots` only needs to avoid a player filling two slots
//   on the *same* roster, not cross-roster exclusivity.
// - `draft_deadline` + `is_locked`/`locked_at` are Phase-1-specific additions
//   (not in the spec's literal schema) needed to implement the draft timer
//   and blind-reveal-on-lock behavior from spec section 4.
//
// spec section 3's original `players` / `player_stats` / `player_ratings`
// (one row per real person, career-aggregated) is SUPERSEDED by spec
// section 4c's team+era stint redesign — see the `PlayerStint` doc comment
// below. This was a breaking rebuild (old tables dropped, not migrated —
// this is a dev DB with no real user data to preserve).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sport {
  nba
  nfl
}

// Drives leaderboard eligibility (spec section 9a) — only random_matchmaking
// games count toward stats, since a friend link is trivially self-matchable
// (send it to yourself/an alt account and farm wins). Every match created so
// far is friend_link; the random-matchmaking queue itself is deliberately
// not built yet (agreed scope line — see README), but the column and the
// eligibility check are in place now so nothing needs to change when it is.
enum MatchType {
  friend_link
  random_matchmaking
}

// Era buckets a team+era combo is randomly assigned from (spec 4c). Fixed,
// small set rather than free-form years — matches the "Team + Era
// combination" framing (e.g. "Miami + 2010s"), not arbitrary date ranges.
enum Era {
  sixties
  seventies
  eighties
  nineties
  two_thousands
  twenty_tens
  twenty_twenties
}

// Why a given player_stint_stats row is an estimate rather than a sourced
// figure (spec section 10 "Estimating stats from pre-tracking eras") —
// deliberately two distinct reasons, not one boolean, because the UI must
// show different tooltip copy for each (see PlayerStintStat doc comment):
// - pre_tracking_era: the stat is a real, historical quantity that simply
//   wasn't officially recorded yet (steals/blocks/turnovers before the
//   1973-74 season) — a recovery estimate for a number that truly existed.
// - hypothetical_pre_three_point: a genuinely counterfactual "what if" —
//   3-point shooting stats for a stint before the line existed at all
//   (pre-1979-80), estimated from FT%/position-adjusted FG%/reputation
//   signals (see estimatePreThreePointStats.ts) purely to give draft-time
//   signal, not a recovery of a real number.
enum StatEstimateReason {
  pre_tracking_era
  hypothetical_pre_three_point
}

// Sprite personalization for the GameCast animation (spec 4a) is skin tone
// only — no facial detail, no jersey/team accuracy. A small fixed palette
// (not a hex color) keeps the sprite art bounded to a few pre-drawn
// variants rather than needing per-player custom art.
enum SkinTone {
  light
  medium
  dark
}

// City/moniker only (e.g. "Chicago," "Utah") — NOT full franchise names or
// logos, per spec 4c's trademark-avoidance guidance (section 10). colorHex
// is a cosmetic, consistent-per-team visual cue for the draft screen; it
// deliberately does not need to match real team branding (spec is explicit
// about this) — picked for visual distinctiveness across the seeded teams,
// not researched against real franchise colors.
model Team {
  id       String @id @default(uuid())
  sport    Sport
  name     String
  colorHex String @map("color_hex")

  stints PlayerStint[]

  @@unique([sport, name])
  @@map("teams")
}

// Spec 4c's core redesign: a real person becomes MULTIPLE rows here, one
// per team+era stint, rather than the one-row-per-career-player shape
// section 3 originally specified. Selecting "Miami + 2010s" for a draft
// slot pulls whoever actually played for that team during that era, with
// stats scoped to that specific stint (see PlayerStintStat) — not their
// full career or even their full decade if they played for multiple teams
// within it (e.g. LeBron James: a separate stint row for Cleveland/2000s
// and for Miami/2010s, each with that stint's own numbers).
//
// `personKey` is a stable identity shared across a real person's stints
// (e.g. "lebron_james") — deliberately a separate field rather than
// relying on exact `name` string equality, so the "no duplicate real
// person on one roster" rule (spec 4c) has a robust key to check even if
// two different people ever shared a display name. It's set by hand at
// seed time, not derived.
//
// No `photoUrl` here (unlike the old `players` table) — still names/stats
// only per spec section 10's legal notes; skin tone is the one exception,
// used only for the schematic GameCast sprite, not a photo/likeness.
model PlayerStint {
  id              String   @id @default(uuid())
  sport           Sport
  personKey       String   @map("person_key")
  name            String
  primaryPosition String   @map("primary_position")
  teamId          String   @map("team_id")
  team            Team     @relation(fields: [teamId], references: [id])
  era             Era
  stintStartYear  Int      @map("stint_start_year")
  stintEndYear    Int      @map("stint_end_year")
  // A stint is, by definition, a specific bounded period with one team —
  // always false in this seed data, even for a person who is still an
  // active NBA player elsewhere today, since this particular stint has
  // ended. Kept (rather than dropped) for schema continuity with the
  // original `players.is_active` and in case a still-ongoing stint is
  // seeded later.
  isActive        Boolean  @map("is_active")
  skinTone        SkinTone @map("skin_tone")

  stats  PlayerStintStat[]
  rating PlayerStintRating?

  // Lets the seed script upsert idempotently. A real person can have
  // multiple stints (different team+era), so uniqueness is per stint, not
  // per person — (sport, team, era, name) is the natural key for "this
  // specific stint."
  @@unique([sport, teamId, era, name])
  @@map("player_stints")
}

// Flexible per-stint stat storage — same shape/purpose as the original
// player_stats, just scoped to a stint instead of a career. stat_key
// examples unchanged: 'ppg','apg','rpg','spg','bpg','tov_pg','fg_pct',
// 'three_pt_pct','three_pt_rate','ft_pct','ast_rate','reb_rate','stl_rate',
// 'blk_rate'. scope is 'stint' for every Phase 1 row (the original
// 'career'/'peak_3yr'/'last_season' distinction doesn't apply once every
// row already IS a bounded stint).
//
// estimateReason is null for the vast majority of rows (real, sourced
// figures) and set only for the handful of pre-1974/pre-1980 rows where
// the underlying stat had to be estimated (see StatEstimateReason and
// nbaStints.ts's header comment) — this is what lets the API tell the
// frontend which values need the spec 10 asterisk/tooltip treatment,
// without the frontend having to know anything about NBA history itself.
model PlayerStintStat {
  id             String              @id @default(uuid())
  stintId        String              @map("stint_id")
  stint          PlayerStint         @relation(fields: [stintId], references: [id], onDelete: Cascade)
  statKey        String              @map("stat_key")
  statValue      Decimal             @map("stat_value") @db.Decimal(8, 4)
  scope          String
  estimateReason StatEstimateReason? @map("estimate_reason")

  @@unique([stintId, statKey, scope])
  @@map("player_stint_stats")
}

// Precomputed composite ratings — recalculated offline (spec section 6),
// never computed live during a draft or sim. Same shape as the original
// player_ratings; z-scored against stint-scoped stats now (see
// computeRatings.ts), which if anything gives more, not less, signal than
// the original career-aggregate version since a stint's numbers reflect a
// specific, shorter, more consistent stretch of play.
model PlayerStintRating {
  stintId String      @id @map("stint_id")
  stint   PlayerStint @relation(fields: [stintId], references: [id], onDelete: Cascade)

  baseRating     Decimal  @map("base_rating") @db.Decimal(6, 2)
  offenseRating  Decimal  @map("offense_rating") @db.Decimal(6, 2)
  defenseRating  Decimal  @map("defense_rating") @db.Decimal(6, 2)
  // Multiplies base_rating in crunch time (spec section 5.4). Not yet
  // consumed by the sim engine — that mechanic is Phase 2 — but the column
  // exists now per spec's schema so no migration is needed when it lands.
  // Defaults to 1.0 (neutral) for every Phase 1 seed stint; see seed data
  // comments for why.
  clutchModifier Decimal  @map("clutch_modifier") @db.Decimal(4, 3)
  usageRate      Decimal  @map("usage_rate") @db.Decimal(5, 4)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("player_stint_ratings")
}

// Anonymous, session-token-identified "account" — see the file header for
// why this isn't real auth. displayName is auto-generated (e.g. "Player
// 4821") at creation and unique-by-construction (retry-on-collision, see
// session.guard.ts); spec section 9a adds the ability for a user to choose
// their own name instead, subject to moderation and this same uniqueness
// constraint (see users/ module).
model User {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  displayName  String   @unique @map("display_name")
  createdAt    DateTime @default(now()) @map("created_at")

  rosters Roster[]

  @@map("users")
}

// One roster per user per match side (spec: `rosters.slots` is a JSONB
// { position: player_id } map). NBA-only in Phase 1, so `mode` (NFL's
// offense-only/offense+defense choice) is always null here.
model Roster {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport         Sport     @default(nba)
  mode          String?
  // { "PG": playerId, "SG": playerId, ... } — partial while drafting,
  // must have all six NBA slots filled to lock (auto-fill guarantees this
  // on timer expiry; a manual lock requires the drafter to have filled it
  // themselves).
  slots         Json      @default("{}")
  isLocked      Boolean   @default(false) @map("is_locked")
  lockedAt      DateTime? @map("locked_at")
  draftDeadline DateTime  @map("draft_deadline")
  createdAt     DateTime  @default(now()) @map("created_at")

  matchAsA Match? @relation("MatchRosterA")
  matchAsB Match? @relation("MatchRosterB")

  @@map("rosters")
}

// A friend-link match. `roomCode` is the entire matchmaking mechanism for
// Phase 1 (no random queue). `status` matches spec's three values exactly —
// whether side B has joined yet is inferred from `rosterBId` being null,
// not a separate status value.
model Match {
  id                String    @id @default(uuid())
  sport             Sport     @default(nba)
  roomCode          String    @unique @map("room_code")
  matchType         MatchType @default(friend_link) @map("match_type")
  rosterAId         String?   @unique @map("roster_a_id")
  rosterA           Roster?   @relation("MatchRosterA", fields: [rosterAId], references: [id])
  rosterBId         String?   @unique @map("roster_b_id")
  rosterB           Roster?   @relation("MatchRosterB", fields: [rosterBId], references: [id])
  // Kept per spec's schema; Phase 1 always uses 1 (best-of-N is out of scope
  // for now — spec section 5.6).
  gamesToPlay       Int       @default(1) @map("games_to_play")
  draftTimerSeconds Int       @default(300) @map("draft_timer_seconds")
  status            String    @default("drafting") // 'drafting' | 'simulating' | 'complete'
  createdAt         DateTime  @default(now()) @map("created_at")

  gameResults GameResult[]

  @@map("matches")
}

// One row per simulated game (Phase 1: always exactly one per match, since
// games_to_play is hardcoded to 1). recapHeadline/recapArticle are nullable
// — populated only once ANTHROPIC_API_KEY is configured and recap
// generation actually runs; see apps/api/src/recap/.
model GameResult {
  id              String   @id @default(uuid())
  matchId         String   @map("match_id")
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber      Int      @default(1) @map("game_number")
  scoreA          Int      @map("score_a")
  scoreB          Int      @map("score_b")
  boxScore        Json     @map("box_score")
  playLog         Json     @map("play_log")
  highlights      Json
  mvp             Json
  overtimePeriods Int      @default(0) @map("overtime_periods")
  recapHeadline   String?  @map("recap_headline")
  recapArticle    String?  @map("recap_article")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("game_results")
}
