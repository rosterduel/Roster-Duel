{
  "name": "roster-duel",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w packages/sim-engine",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "test:sim": "npm run test -w packages/sim-engine",
    "test:api": "npm run test -w apps/api",
    "demo:sim": "npm run demo -w packages/sim-engine",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
